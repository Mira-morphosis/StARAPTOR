{#- A single review card, faithful to the design prototype (review.html):
    sentiment badge + publication date on top, review body, then a Steam-style
    metadata footer with ratings and contextual chips. -#}
{% set positive = rev.voted_up %}

<article class="w-full bg-black/20 p-4 sm:p-5">

  <!-- Sentiment badge + publication date -->
  <div class="flex items-end justify-between gap-x-4 mb-3">
    <div class="flex items-center gap-x-3 min-w-0">
      {% if positive %}
        <svg class="size-6 sm:size-7 text-[#8bc98b] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7.493 18.5c-.425 0-.82-.236-.975-.632A7.48 7.48 0 0 1 6 15.125c0-1.75.599-3.358 1.602-4.634.151-.192.373-.309.6-.397.473-.183.89-.514 1.212-.924a9.042 9.042 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75A.75.75 0 0 1 15 2a2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H14.23c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23h-.777ZM2.331 10.727a11.969 11.969 0 0 0-.831 4.398 12 12 0 0 0 .52 3.507C2.28 19.482 3.105 20 3.994 20H4.9c.445 0 .72-.498.523-.898a8.963 8.963 0 0 1-.924-3.977c0-1.708.476-3.305 1.302-4.666.245-.403-.028-.959-.5-.959H4.25c-.832 0-1.612.453-1.918 1.227Z"/>
        </svg>
        <span class="text-[#8bc98b] font-semibold text-lg sm:text-xl leading-tight">Positive Review</span>
      {% else %}
        <svg class="size-6 sm:size-7 text-[#e19c9d] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M15.73 5.5h1.035A7.465 7.465 0 0 1 18 9.625a7.465 7.465 0 0 1-1.235 4.125h-.148c-.806 0-1.534.446-2.031 1.08a9.04 9.04 0 0 1-2.861 2.4c-.723.384-1.35.956-1.653 1.715a4.499 4.499 0 0 0-.322 1.672v.633A.75.75 0 0 1 9 22a2.25 2.25 0 0 1-2.25-2.25c0-1.152.26-2.243.723-3.218.266-.558-.107-1.282-.725-1.282H3.622c-1.026 0-1.945-.694-2.054-1.715A12.137 12.137 0 0 1 1.5 12.25c0-2.848.992-5.464 2.649-7.521C4.537 4.247 5.136 4 5.754 4H9.77a4.5 4.5 0 0 1 1.423.23l3.114 1.04a4.5 4.5 0 0 0 1.423.23ZM21.669 14.023c.536-1.362.831-2.845.831-4.398 0-1.22-.182-2.398-.52-3.507-.26-.85-1.084-1.368-1.973-1.368H19.1c-.445 0-.72.498-.523.898.591 1.2.924 2.55.924 3.977a8.958 8.958 0 0 1-1.302 4.666c-.245.403.028.959.5.959h1.053c.832 0 1.612-.453 1.918-1.227Z"/>
        </svg>
        <span class="text-[#e19c9d] font-semibold text-lg sm:text-xl leading-tight">Negative Review</span>
      {% endif %}
    </div>
    {% if rev.date_str %}
    <span class="text-white/40 font-semibold uppercase tracking-wide text-xs sm:text-sm shrink-0">
      {{ rev.date_str }}
    </span>
    {% endif %}
  </div>

  <!-- Review body -->
  {% if rev.text %}
    <p class="text-white/70 text-sm sm:text-base leading-relaxed whitespace-pre-line mb-3">{{ rev.text }}</p>
  {% else %}
    <p class="text-white/40 italic text-sm sm:text-base leading-relaxed mb-3">This review has no text.</p>
  {% endif %}

  <!-- Pillar ratings (only the pillars this review actually scored) -->
  {% if rev.has_pillars %}
  <div class="flex flex-wrap gap-x-2 gap-y-1.5 mb-3">
    {% for label, value in rev.pillars %}
      {% if value is not none %}
      <span class="inline-flex items-center gap-x-1.5 bg-white/5 border border-white/10 rounded px-2 py-0.5 text-xs leading-tight">
        <span class="text-white/50">{{ label }}</span>
        <span class="text-white font-medium">{{ value }}/5</span>
      </span>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <!-- Steam-style metadata footer -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 pt-2.5 border-t border-white/10 text-xs">

    {% if rev.recommends %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        Recommended
      </span>
    {% else %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Did not recommend
      </span>
    {% endif %}

    <span class="inline-flex items-center gap-x-1.5 text-white/70">
      <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      {{ rev.playtime_hours }} hrs on record
    </span>

    {% if rev.steam_purchase %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 10V5a2 2 0 012-2z"></path>
        </svg>
        Owning the Game
      </span>
    {% elif rev.received_for_free %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 10V5a2 2 0 012-2z"></path>
        </svg>
        Free Promotion
      </span>
    {% endif %}

    {% if rev.steam_deck %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-2m3 2v-2M3 17h18M5 7h14a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2zm0 0V5a2 2 0 012-2h10a2 2 0 012 2v2"></path>
        </svg>
        Steam Deck
      </span>
    {% endif %}

    {% if rev.is_useful %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
        Found helpful
      </span>
    {% endif %}

    {% if rev.language %}
      <span class="inline-flex items-center gap-x-1.5 text-white/70">
        <svg class="size-3.5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {{ rev.language }}
      </span>
    {% endif %}

    <span class="inline-flex items-center gap-x-1.5 text-white/70 ml-auto">
      <span class="text-white/40">Weighted Score:</span>
      <span class="text-white font-medium">{{ rev.score }}</span>
    </span>
  </div>
</article>
