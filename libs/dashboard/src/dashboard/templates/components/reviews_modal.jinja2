<div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-[#171d25] border border-white/10 rounded-lg max-w-4xl w-full max-h-[85vh] flex flex-col p-6 shadow-2xl">
        <div class="flex justify-between items-center mb-4 border-b border-white/10 pb-3">
            <div>
                <span class="text-white/60 text-xs uppercase tracking-wider block">{{ game_name }}</span>
                <h2 class="text-white font-semibold text-xl tracking-wide">Reviews</h2>
                <p class="text-xs text-white/70 mt-1"><span class="text-[#67c1f5] font-medium">{{ rule_display }}</span></p>
            </div>
            <button onclick="document.getElementById('reviews-modal-container').innerHTML=''" class="text-white/60 hover:text-white text-xl font-bold p-2 cursor-pointer">✕</button>
        </div>

        <div class="flex-1 overflow-y-auto space-y-4 pr-1">
            {% if reviews_data %}
                {% for rev in reviews_data %}
                <div class="p-4 rounded-lg bg-gradient-to-r from-white/[0.04] to-white/[0.02] border border-white/10 shadow-md">
                    <div class="flex justify-between items-center text-xs mb-2">
                        {% if rev.voted_up %}
                            <span class="font-semibold px-2.5 py-0.5 rounded bg-green-500/20 text-green-400 border border-green-500/30">
                                Positive Review
                            </span>
                        {% else %}
                            <span class="font-semibold px-2.5 py-0.5 rounded bg-red-500/20 text-red-400 border border-red-500/30">
                                Negative Review
                            </span>
                        {% endif %}
                        <span class="text-white/50 uppercase font-medium tracking-wider text-[10px]">{{ rev.date_str }}</span>
                    </div>

                    <p class="text-white/90 text-sm leading-relaxed mb-3 whitespace-pre-line">{{ rev.text }}</p>

                    <div class="pt-2.5 border-t border-white/10 flex flex-wrap items-center gap-4 text-xs text-white/70 bg-black/20 p-2.5 rounded">
                        <div><span class="text-white/40">Weighted Score:</span> <span class="text-white font-medium">{{ rev.score }}</span></div>
                        <div><span class="text-white/40">Playtime:</span> <span class="text-white font-medium">{{ rev.playtime }} hrs</span></div>
                        {% if rev.gameplay is not none %}
                            <div><span class="text-white/40">Gameplay:</span> <span class="text-white font-medium">{{ rev.gameplay }}/5</span></div>
                        {% endif %}
                        {% if rev.community is not none %}
                            <div><span class="text-white/40">Community:</span> <span class="text-white font-medium">{{ rev.community }}/5</span></div>
                        {% endif %}
                        {% if rev.story is not none %}
                            <div><span class="text-white/40">Story:</span> <span class="text-white font-medium">{{ rev.story }}/5</span></div>
                        {% endif %}
                        {% if rev.audio is not none %}
                            <div><span class="text-white/40">Audio:</span> <span class="text-white font-medium">{{ rev.audio }}/5</span></div>
                        {% endif %}
                        {% if rev.graphics is not none %}
                            <div><span class="text-white/40">Graphics:</span> <span class="text-white font-medium">{{ rev.graphics }}/5</span></div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <p class="text-white/50 italic text-center py-8">No reviews found.</p>
            {% endif %}
        </div>
    </div>
</div>