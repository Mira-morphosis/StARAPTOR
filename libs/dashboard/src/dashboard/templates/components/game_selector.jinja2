<div class="relative flex items-center gap-x-2">
  <button onclick="toggleDropdown()" class="flex items-center gap-x-2.5 hover:opacity-80 transition focus:outline-none cursor-pointer">
    <img src="{{ current_game.icon_url }}" class="h-6 w-auto max-w-[80px] object-contain shadow-sm" alt="{{ current_game.name }}" />
    <span class="text-white text-base sm:text-lg font-medium leading-[1.2]">{{ current_game.name }}</span>
    <svg class="size-4 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div id="games-dropdown-menu"
       class="hidden absolute top-full left-0 mt-2 w-64 bg-[#3D4450] text-white border border-white/10 shadow-[0_12px_28px_rgba(0,0,0,0.85)] z-50 py-1.5 max-h-72 overflow-y-auto">
    <div class="px-3 py-1 text-[10px] font-semibold tracking-wider text-white/60 uppercase">
      Available Games
    </div>

    {% for game in available_games %}
      <a href="/?app_id={{ game.app_id }}"
         class="flex items-center px-4 py-2 text-sm transition {% if game.is_active %}text-white bg-white/20 font-semibold{% else %}text-white/90 hover:text-white hover:bg-white/10{% endif %}">
        {{ game.name }}
      </a>
    {% endfor %}

    <div class="border-t border-white/10 my-1"></div>

    <button onclick="openTrackGameModal()"
            type="button"
            class="w-full text-left flex items-center gap-x-2 px-4 py-2 text-sm text-white font-medium hover:bg-white/10 transition cursor-pointer">
      <span class="flex items-center justify-center size-5 bg-[#1a9fff] text-white text-xs font-bold">+</span>
      <span>Track new game</span>
    </button>
  </div>
</div>

<div id="track-game-modal"
     class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4"
     onclick="closeTrackGameModal()">
  <div class="bg-[#171d25] border border-white/10 max-w-md w-full p-6 shadow-2xl relative text-white"
       onclick="event.stopPropagation()">
    <div class="flex justify-between items-center mb-4 border-b border-white/10 pb-3">
      <h3 class="text-lg font-semibold text-white flex items-center gap-2">
        <span>Track New Game</span>
      </h3>
      <button onclick="closeTrackGameModal()" class="text-white/60 hover:text-white text-lg font-bold p-1 cursor-pointer">✕</button>
    </div>

    <form onsubmit="handleTrackGameSubmit(event)" class="space-y-4">
      <div>
        <label for="track-appid-input" class="block text-xs font-medium text-white/80 uppercase tracking-wider mb-2">
          Steam App ID
        </label>
        <input type="number"
               id="track-appid-input"
               placeholder="E.g. 1086940"
               required
               min="1"
               class="w-full bg-[#2a475e]/50 border border-white/20 px-3 py-2 text-white placeholder-white/40 focus:outline-none focus:border-[#1a9fff] text-sm" />
        <p class="text-xs text-white/50 mt-2 leading-relaxed">
          Enter the numeric Steam App ID. The dashboard will open for this game; the first update run will create its archive.
        </p>
      </div>

      <div class="flex justify-end gap-x-2 pt-2">
        <button type="button"
                onclick="closeTrackGameModal()"
                class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-medium transition cursor-pointer">
          Cancel
        </button>
        <button type="submit"
                class="px-4 py-2 bg-[#1a9fff] hover:bg-[#1582d1] text-white text-xs font-semibold transition cursor-pointer">
          Open Dashboard
        </button>
      </div>
    </form>
  </div>
</div>