STARAPTOR_DB_ROOT=~/.staraptor/

# openai_compatible (vLLM, llama.cpp, Ollama, OpenAI...) or anthropic
STARAPTOR_PROVIDER_TYPE=openai_compatible

# Server endpoint. If using OpenAI's cloud API, leave this field empty.
STARAPTOR_BASE_URL=http://localhost:8000/

# API key required by the endpoint.
# If the endpoint requires none, put here a placeholder
STARAPTOR_API_KEY=staraptor

# How Instructor should force the output (Opzioni: JSON, TOOLS, JSON_SCHEMA)
STARAPTOR_INSTRUCTOR_MODE=JSON

# Used for Anthropic API (as it does not list any available models)
STARAPTOR_AVAILABLE_MODELS_FALLBACK=claude-haiku-4-5

# Batch concurrency
STARAPTOR_CONCURRENCY_LIMIT=34

# The minimum number of reviews for association mining
STARAPTOR_MINING_THRESHOLD=500

# Every STARAPTOR_MINING_MIN_DAYS_LOOKBACK_DELTA days, a check is launched
# to see if there are enough reviews to launch an analysis.
# The lookback window size is also a multiple of this number.
STARAPTOR_MINING_MIN_DAYS_LOOKBACK_DELTA=7

# The maximum number of days covered by an analysis.
STARAPTOR_MAX_LOOKBACK_DAYS=140